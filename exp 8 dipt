    "# Step 3: Use Global Thresholding to segment the image\n",
    "# Apply global thresholding with a threshold value of 127\n",
    "_, global_thresholded = cv2.threshold(gray_image, 127, 255, cv2.THRESH_BINARY)"
   ]
  },
